---
layout: base.njk
pageTitle: "Jason Carvalho — Developer & Researcher"
navItem: home
pageCSS: /css/home.css
---

{% set researchCount = research | length %}
{% set toolCount = work_tools | length %}
{% set projCount = personal_projects | length %}
{% set pubCount = publications | length %}

<main class="hub">

    <!-- ── HERO — intro tile + quick links (primary) ──────── -->
    <div class="hub-hero">

        <div class="intro-tile">
            <div class="intro-identity">
                <img src="{{ '/img/JasonCarvalho_stylised.png' | url }}"
                     alt="Jason Carvalho"
                     class="intro-portrait">
                <div class="intro-identity-text">
                    <h1 class="intro-name">Jason<br><em>Carvalho</em></h1>
                    <div class="intro-eyebrow">Research Software Engineer</div>
                    <div class="intro-location">Milton Keynes, UK</div>
                </div>
            </div>
            <p class="intro-bio">Projects, code, a few photos and resources, sim racing,
                links to work sites and publications — bits and pieces that are handy
                to pop online.</p>
        </div>

        <div class="quick-links">
            <div class="ql-col">
                <div class="ql-head">Find me elsewhere</div>
                <a href="https://youtube.com/@JaseMK2001" target="_blank" rel="noopener" class="ql-row">
                    <span class="ql-label">youtube</span>
                    <span class="ql-detail">@JaseMK2001 — sim racing &amp; project videos</span>
                    <span class="ql-meta">↗</span>
                </a>
                <a href="https://instagram.com/jase_mk/" target="_blank" rel="noopener" class="ql-row">
                    <span class="ql-label">instagram</span>
                    <span class="ql-detail">@jase_mk</span>
                    <span class="ql-meta">↗</span>
                </a>
                <a href="https://flickr.com/photos/jase_mk/" target="_blank" rel="noopener" class="ql-row">
                    <span class="ql-label">flickr</span>
                    <span class="ql-detail">photostream — sim racing shots</span>
                    <span class="ql-meta">↗</span>
                </a>
                <a href="https://github.com/jasemk" target="_blank" rel="noopener" class="ql-row">
                    <span class="ql-label">github</span>
                    <span class="ql-detail">code &amp; project sources</span>
                    <span class="ql-meta">↗</span>
                </a>
                <a href="https://facebook.com/jason.carvalho" target="_blank" rel="noopener" class="ql-row">
                    <span class="ql-label">facebook</span>
                    <span class="ql-detail">jason.carvalho</span>
                    <span class="ql-meta">↗</span>
                </a>
            </div>
            <div class="ql-col">
                <div class="ql-head">Highlights</div>
                <a href="{{ '/work/' | url }}#publications" class="ql-row">
                    <span class="ql-label">latest paper</span>
                    <span class="ql-detail">{{ publications[0].title }}</span>
                    <span class="ql-meta">{{ publications[0].year }}</span>
                </a>
                {% for proj in personal_projects %}{% if proj.status == 'in progress' %}
                <a href="{{ '/projects/' | url }}" class="ql-row">
                    <span class="ql-label">now building</span>
                    <span class="ql-detail">{{ proj.name }}</span>
                    <span class="ql-meta">in progress</span>
                </a>
                {% endif %}{% endfor %}
                <a href="{{ '/sim-racing/' | url }}" class="ql-row">
                    <span class="ql-label">sim racing</span>
                    <span class="ql-detail">Current season stats &amp; rig setup</span>
                    <span class="ql-meta">iRacing</span>
                </a>
                <a href="mailto:jase@jasoncarvalho.com" class="ql-row">
                    <span class="ql-label">say hello</span>
                    <span class="ql-detail">jase@jasoncarvalho.com</span>
                    <span class="ql-meta">email</span>
                </a>
            </div>
        </div>

    </div>

    <!-- ── EXPLORE — doors (secondary) ────────────────────── -->
    <div class="hub-explore">
        <div class="explore-rule"><span>Explore</span></div>

        <div class="doors">

            <a href="{{ '/projects/' | url }}" class="door">
                <div class="door-head">
                    <span class="door-label">Projects</span>
                    <span class="door-count">{{ projCount | zeroPad(2) }}</span>
                </div>
                <div class="door-rows">
                    {% for proj in personal_projects %}
                    <div class="door-row">
                        <span class="door-row-title">{{ proj.name }}</span>
                        <span class="door-row-meta">{{ proj.status }}</span>
                    </div>
                    {% endfor %}
                </div>
                <div class="door-footer">all projects →</div>
            </a>

            <a href="{{ '/work/' | url }}" class="door">
                <div class="door-head">
                    <span class="door-label">Work</span>
                    <span class="door-count">tools · research</span>
                </div>
                <div class="door-rows">
                    <div class="door-row">
                        <span class="door-row-title">Tools &amp; applications</span>
                        <span class="door-row-meta">{{ toolCount | zeroPad(2) }}</span>
                    </div>
                    <div class="door-row">
                        <span class="door-row-title">Research projects</span>
                        <span class="door-row-meta">{{ researchCount | zeroPad(2) }}</span>
                    </div>
                    <div class="door-row">
                        <span class="door-row-title">Publications</span>
                        <span class="door-row-meta">{{ pubCount | zeroPad(2) }}</span>
                    </div>
                </div>
                <div class="door-footer">work &amp; publications →</div>
            </a>

            <a href="{{ '/photos/' | url }}" class="door door--image">
                <img src="{{ '/img/sims/iRacing%20%20Motorsport%20Simulator%20Screenshot%202026.01.31%20-%2010.13.01.75.jpg' | url }}"
                     alt="Ferrari 296 GT3 vs Corvette Z06, Watkins Glen" loading="lazy">
                <div class="door-shade"></div>
                <div class="door-image-bar">
                    <span class="door-image-label">Photos</span>
                    <span class="door-image-cta">gallery →</span>
                </div>
            </a>

            <a href="{{ '/sim-racing/' | url }}" class="door door--image">
                <img src="{{ '/img/sims/iRacing%20%20Motorsport%20Simulator%20Screenshot%202026.03.06%20-%2014.24.08.73.jpg' | url }}"
                     alt="Hyundai Elantra N TCR, Donington Park" loading="lazy">
                <div class="door-shade"></div>
                <div class="door-image-bar">
                    <span class="door-image-label">Sim racing</span>
                    <span class="door-image-cta">stats &amp; setup →</span>
                </div>
            </a>

        </div>
    </div>

</main>
