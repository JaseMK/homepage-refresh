---
layout: page.njk
title: Work
navItem: work
narrow: true
subtitle: Tools and applications built professionally, research projects, and publications.
pageCSS: /css/work.css
---

<div class="page-content page-content--narrow">

    <!-- Tools & Applications -->
    <section class="work-section">
        <div class="work-label">Tools &amp; applications</div>
        <div class="work-panel">
            {% for item in work_tools %}
            <a href="{{ item.url }}" class="work-row" {% if item.url != '#' %}target="_blank" rel="noopener"{% endif %}>
                <div>
                    <div class="work-row-name">{{ item.name }}</div>
                    <div class="work-row-desc">{{ item.description }}</div>
                </div>
                <span class="status-dot status-dot--{{ item.status | replace(' ', '') }}">{{ item.status }}</span>
            </a>
            {% endfor %}
        </div>
    </section>

    <!-- Research projects -->
    <section class="work-section">
        <div class="work-label">Research projects</div>
        <div class="work-panel">
            {% for item in research %}
            <div class="work-row">
                <div>
                    <div class="work-row-name">{{ item.title }}</div>
                    <div class="work-row-desc">{{ item.description }}</div>
                </div>
                {% if loop.first %}
                <span class="status-dot status-dot--ongoing">ongoing</span>
                {% else %}
                <span class="status-dot status-dot--complete">complete</span>
                {% endif %}
            </div>
            {% endfor %}
        </div>
    </section>

    <!-- Publications -->
    <section id="publications" class="work-section">
        <div class="work-label">Publications</div>
        {% for pub in publications %}
        <div class="pub-row">
            <span class="pub-num">{{ loop.index | zeroPad(2) }}</span>
            <div>
                <div class="pub-title">{{ pub.title }}</div>
                <div class="pub-meta">{{ pub.authors }} · {{ pub.venue }}</div>
            </div>
            <span class="pub-year">{{ pub.year }}</span>
        </div>
        {% endfor %}
    </section>

    <!-- External project websites -->
    <section class="work-section">
        <div class="work-label">Project websites</div>
        <div class="work-panel">
            {% for ext in work_external %}
            <a href="{{ ext.url }}" class="work-row" {% if ext.url != '#' %}target="_blank" rel="noopener"{% endif %}>
                <div>
                    <div class="work-row-name">{{ ext.name }}</div>
                    <div class="work-row-desc">{{ ext.description }}</div>
                </div>
                <span class="work-row-url">{{ ext.url_label }} ↗</span>
            </a>
            {% endfor %}
        </div>
    </section>

</div>
